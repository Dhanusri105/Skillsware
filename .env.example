# Root Environment Configuration Template
NODE_ENV=development
PORT=5000

# Backend PostgreSQL Database URL (Prisma)
# Example: postgresql://postgres:password@localhost:5432/skillsware?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillsware?schema=public

# Security & Authentication
JWT_SECRET=super_secret_skillsware_jwt_token_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Frontend Base URL (for CORS and reset password links)
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api

# Optional: Code Execution Service (Judge0 or custom sandbox)
# If left empty, Code Arena uses the built-in sandbox with isolated execution & test case verification
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Optional: Email Service for Password Reset (Nodemailer / SendGrid / Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@skillsware.dev
